<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>doom_nextcloud</id>
	<name>Doom</name>
	<summary>Play Doom directly in Nextcloud</summary>
	<description>
		Play the classic Doom game without leaving Nextcloud. Open Doom from the top menu, press play, and face demons in the futuristic bases of Mars.

		Adjust the mouse sensitivity, sound, and other game options to suit you. If you use a js-dos account, save your key in your personal Doom settings to stay signed in across browsers and devices. Your account information is stored securely and can be removed at any time.
	</description>
	<version>2.0.0</version>
	<licence>agpl</licence>
	<author mail="yvesamorim73@gmail.com" homepage="https://yvescesar.github.io/">Yves César Amorim de Azevedo</author>
	<namespace>Doom</namespace>
	<category>games</category>
	<bugs>https://github.com/YvesCesar/doom_nextcloud/issues</bugs>
	<repository type="git">https://github.com/YvesCesar/doom_nextcloud</repository>
	<screenshot>https://github.com/user-attachments/assets/d4cfd4ff-b939-45e3-8eff-ef72c745e4ee</screenshot>
